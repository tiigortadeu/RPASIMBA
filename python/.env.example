# Copie para python/.env em cada runner (o .env não vai para o git).

# ServiceNow: usuário de integração com basic auth (o SSO não serve para runners).
SN_INSTANCIA=xpinvestimentosdev
SN_USUARIO=
SN_SENHA=

# Identificação do runner nos work items (padrão: <máquina>-<usuário Windows>).
# RUNNER_ID=runner-01

# Pasta dos arquivos de chaves do Transmissor (um por instituição).
SIMBA_CHAVES_DIR=
# Senha de cada arquivo de chaves: SIMBA_SENHA_<nome do arquivo sem extensão, em maiúsculas, com _ no lugar de espaços/símbolos>.
# Ex.: chave "XP Corretora.chave" -> SIMBA_SENHA_XP_CORRETORA
# SIMBA_SENHA_XP_CORRETORA=

# Opcionais
# SIMBA_HOME=            pasta "Programas SIMBA" (padrão: Documentos do usuário)
# SIMBA_TRANSMITIDOS=    uma pasta por caso com o comprovante PDF + zip dos GABs (padrão: <SIMBA_HOME>\Transmitidos; pode ser pasta de rede)
# SIMBA_ARQUIVO=         casos já processados, retirados do dadosValidador (padrão: <SIMBA_HOME>\Arquivo)
# SIMBA_TRABALHO=        downloads temporários por work item (padrão: <SIMBA_HOME>\Trabalho)
# SN_FILA_TESTE=         fila usada por pytest -m servicenow (padrão: "Simba Runner Teste")
