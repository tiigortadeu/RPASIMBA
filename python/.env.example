# Copie para .env na raiz do projeto (ao lado de bot.py) em cada máquina/VM. O .env não vai para o git.
# Variáveis já definidas no ambiente têm prioridade sobre o .env.

# --- ServiceNow: usuário de integração com basic auth (o SSO não serve para runners) ---
SN_INSTANCIA=minha-instancia
SN_USUARIO=
SN_SENHA=
# Requisições por minuto deste runner (padrão 50). O usuário de integração é bloqueado acima de 100/min no total:
# com N runners/VMs usando o mesmo usuário, a soma dos valores precisa ficar abaixo disso. Com 1 VM, 70.
SN_REQUISICOES_POR_MINUTO=70

# Só work items criados a partir desta data (AAAA-MM-DD) são processados, recolhidos pelo reaper e mostrados no
# console; os antigos das filas ficam parados. Vazio: todos.
SIMBA_ITENS_DESDE=

# Identificação do runner nos work items (padrão: <máquina>-<usuário Windows>).
# RUNNER_ID=runner-01

# Transmite logo depois da validação, no mesmo work item (padrão 1). Com 0, a transmissão vem da fila do Transmissor.
# SIMBA_TRANSMITIR_APOS_VALIDAR=1

# --- Caminhos do Simba ---
# Pasta base (padrão: "Programas SIMBA" dentro de Documentos do usuário). As demais pastas derivam dela.
SIMBA_HOME=
# Executáveis (padrão: <SIMBA_HOME>\Validador\simba-validador.exe e <SIMBA_HOME>\Transmissor\simba-transmissor.exe).
# Com a versão numa subpasta, informe o caminho completo, ex.: <SIMBA_HOME>\Validador\5.8.7\simba-validador.exe
# SIMBA_VALIDADOR_EXE=
# SIMBA_TRANSMISSOR_EXE=
# dadosValidador de cada programa: o Simba usa a pasta um nível acima da pasta do .exe (padrão calculado assim).
# Se forem pastas diferentes, o RPA copia o atendimento do Validador para o Transmissor antes de transmitir.
# SIMBA_VALIDADOR_DADOS=
# SIMBA_TRANSMISSOR_DADOS=
# Uma pasta por caso com o comprovante PDF + zip dos GABs (padrão: <SIMBA_HOME>\Transmitidos; pode ser pasta de rede).
# SIMBA_TRANSMITIDOS=
# Casos já processados, retirados do dadosValidador (padrão: <SIMBA_HOME>\Arquivo).
# SIMBA_ARQUIVO=
# Downloads temporários por work item (padrão: <SIMBA_HOME>\Trabalho).
# SIMBA_TRABALHO=
# Log do runner (padrão: <SIMBA_HOME>\logs).
# SIMBA_LOGS=
# DLL do Java Access Bridge (padrão: C:\Windows\System32\WindowsAccessBridge-64.dll).
# RC_JAVA_ACCESS_BRIDGE_DLL=
# Opções da JVM ao abrir o Simba. O padrão força português: o idioma do Java vem de quem inicia o programa e, em
# inglês, os diálogos padrão mudam ("Abrir" -> "Open", "Erro" -> "Error").
# SIMBA_JAVA_OPCOES=-Duser.language=pt -Duser.country=BR

# --- Chaves do Transmissor ---
# Pasta dos arquivos .ASB (um por órgão de destino; padrão: <SIMBA_HOME>\Chaves).
SIMBA_CHAVES_DIR=
# CSV com NOME DA CHAVE;SENHA;RESPONSÁVEL (exportado do Excel, separador ";"). O órgão é o código de 3 dígitos no
# nome da chave (ex.: "002-PF RESPONSAVEL.ASB" ou "CHAVE 002.ASB"); com duas linhas do mesmo órgão vale a chave cujo
# arquivo existe na pasta. O runner relê o CSV a cada envio. Padrão: <SIMBA_CHAVES_DIR>\chaves.csv
SIMBA_CHAVES_CSV=

# --- Console (python -m console) ---
# Lista do Bacen (fonte da verdade): planilha com a aba de NUM_CTRL_CCS (aba "3290"). Padrão: <SIMBA_CONSOLE>\lista_bacen.xlsx
SIMBA_LISTA_BACEN=
# Pasta do retrato, planilha, andamento, lotes e exportações (padrão: <SIMBA_HOME>\Console).
# SIMBA_CONSOLE=
# Endereço e porta (padrão 127.0.0.1:8080). O console dispara execuções reais e não tem login: só abra para a
# rede (0.0.0.0) com outra camada de acesso.
# CONSOLE_HOST=127.0.0.1
# CONSOLE_PORTA=8080

# --- Cabine CCS-JUD (scripts cabine_*) ---
# CABINE_EXE=\\servidor\compartilhamento\Cabines\PCabineCCS_JUD.exe

# --- Testes ---
# SN_FILA_TESTE=             fila usada por pytest -m servicenow (padrão: "Simba Runner Teste")
# SIMBA_TESTE_CASOS=         quantidade de casos em tests/test_varios_casos.py (padrão: 10)
# SIMBA_INPUT_DIR=           pasta curta de entrada do testar_fila_servicenow_sem_enviar.py (padrão: %USERPROFILE%\RPA_INPUT)
# SIMBA_MOCK_DIR=            pasta de mock do testar_e2e_local.py (content.txt.txt, GABs, chave e senha)
# CABINE_COMPROVANTE_TESTE=  PDF usado pelo testar_e2e_local.py na Cabine
